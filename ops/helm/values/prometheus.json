{
  "alertmanager": {
    "enabled": true,
    "alertmanagerSpec": {
      "storage": {
        "disableMountSubPath": true,
        "volumeClaimTemplate": {
          "spec": {
            "accessModes": [
              "ReadWriteOnce"
            ],
            "storageClassName": "gp3-encrypted-retain",
            "resources": {
              "requests": {
                "storage": "2Gi"
              }
            }
          }
        }
      },
      "retention": "120h"
    },
    "config": {
      "global": {
        "resolve_timeout": "5m"
      },
      "route": {
        "receiver": "cosmotech-sns",
        "group_by": [
          "alertname",
          "namespace"
        ],
        "group_wait": "30s",
        "group_interval": "1m",
        "repeat_interval": "4h",
        "routes": [
          {
            "receiver": "null",
            "matchers": [
              "alertname=~\"Watchdog|InfoInhibitor\""
            ]
          }
        ]
      },
      "receivers": [
        {
          "name": "null"
        },
        {
          "name": "cosmotech-sns",
          "sns_configs": [
            {
              "topic_arn": "arn:aws:sns:us-east-1:414053644145:cosmotech-lab-alerts",
              "sigv4": {
                "region": "us-east-1"
              },
              "send_resolved": true
            }
          ]
        }
      ]
    }
  },
  "grafana": {
    "additionalDataSources": [
      {
        "access": "proxy",
        "isDefault": false,
        "name": "Tempo",
        "type": "tempo",
        "url": "http://tempo.observability.svc.cluster.local:3200"
      }
    ],
    "enabled": true,
    "persistence": {
      "enabled": true,
      "existingClaim": "grafana-data",
      "storageClassName": "gp3-encrypted-retain",
      "size": "5Gi"
    },
    "resources": {
      "limits": {
        "cpu": "500m",
        "memory": "512Mi"
      },
      "requests": {
        "cpu": "100m",
        "memory": "128Mi"
      }
    },
    "sidecar": {
      "datasources": {
        "name": "prometheus-aws-eks-istio-lab-dev"
      }
    },
    "deploymentStrategy": {
      "type": "Recreate"
    }
  },
  "kube-state-metrics": {
    "resources": {
      "limits": {
        "cpu": "200m",
        "memory": "256Mi"
      },
      "requests": {
        "cpu": "50m",
        "memory": "64Mi"
      }
    }
  },
  "prometheus": {
    "enabled": true,
    "prometheusSpec": {
      "replicas": 1,
      "resources": {
        "limits": {
          "cpu": "1000m",
          "memory": "1Gi"
        },
        "requests": {
          "cpu": "200m",
          "memory": "512Mi"
        }
      },
      "retention": "24h",
      "retentionSize": "4GB",
      "scrapeInterval": "30s",
      "storageSpec": {
        "disableMountSubPath": true,
        "volumeClaimTemplate": {
          "spec": {
            "accessModes": [
              "ReadWriteOnce"
            ],
            "storageClassName": "gp3-encrypted-retain",
            "resources": {
              "requests": {
                "storage": "10Gi"
              }
            }
          }
        }
      }
    }
  },
  "prometheus-node-exporter": {
    "resources": {
      "limits": {
        "cpu": "200m",
        "memory": "128Mi"
      },
      "requests": {
        "cpu": "50m",
        "memory": "64Mi"
      }
    }
  },
  "prometheusOperator": {
    "resources": {
      "limits": {
        "cpu": "300m",
        "memory": "256Mi"
      },
      "requests": {
        "cpu": "50m",
        "memory": "96Mi"
      }
    }
  }
}
