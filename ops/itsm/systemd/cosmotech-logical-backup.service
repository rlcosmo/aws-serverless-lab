[Unit]
Description=CosmoTech consistent MariaDB and PostgreSQL logical backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
ExecStart=/opt/cosmotech/backup-operations/backup-logical.sh
ExecStopPost=/opt/cosmotech/backup-operations/publish-backup-status.sh Logical
User=root
UMask=0077
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/snap
PrivateTmp=true
