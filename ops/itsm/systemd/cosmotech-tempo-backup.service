[Unit]
Description=CosmoTech application-consistent Tempo EBS snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/cosmotech/backup-operations/run-tempo-backup.sh
ExecStopPost=/opt/cosmotech/backup-operations/run-tempo-backup.sh resume
ExecStopPost=/opt/cosmotech/backup-operations/publish-backup-status.sh Tempo
TimeoutStartSec=8min
TimeoutStopSec=3min
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/snap
PrivateTmp=true
