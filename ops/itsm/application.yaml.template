datasources:
  postgres:
    url: jdbc:postgresql://kestra-db:5432/kestra
    driver-class-name: org.postgresql.Driver
    username: kestra
    password: ${KESTRA_DB_PASSWORD}

kestra:
  encryption:
    secret-key: ${KESTRA_ENCRYPTION_SECRET_KEY}
  repository:
    type: postgres
  storage:
    type: local
    local:
      base-path: /app/storage
  queue:
    type: postgres
  server:
    basic-auth:
      username: ${KESTRA_ADMIN_USERNAME}
      password: ${KESTRA_ADMIN_PASSWORD}
    url: http://localhost:8081/
  security:
    instance-owner:
      username: ${KESTRA_ADMIN_USERNAME}
      password: ${KESTRA_ADMIN_PASSWORD}
  tasks:
    tmp-dir:
      path: /tmp/kestra-wd/tmp
