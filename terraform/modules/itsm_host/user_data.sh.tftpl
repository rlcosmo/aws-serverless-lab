#!/bin/bash
set -Eeuo pipefail
umask 077
exec > >(tee -a /var/log/cosmotech-itsm-bootstrap.log | logger -t cosmotech-itsm-bootstrap -s 2>/dev/console) 2>&1

REPOSITORY_URL="${repository_url}"

export DEBIAN_FRONTEND=noninteractive
find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
  -exec sed -i -e 's|^deb http://|deb https://|' -e 's|URIs: http://|URIs: https://|' {} +
apt-get update
apt-get install -y ca-certificates curl docker.io docker-compose-v2 gettext-base git jq openssl snapd
systemctl enable --now docker
systemctl enable --now snapd.socket
snap install aws-cli --classic
export PATH="/snap/bin:$PATH"

install -d -o root -g root -m 0750 /opt/cosmotech
git clone --depth 1 --branch main "$REPOSITORY_URL" /opt/cosmotech/aws-serverless-lab
bash /opt/cosmotech/aws-serverless-lab/ops/itsm/install-tools.sh

if ! systemctl is-active --quiet snap.amazon-ssm-agent.amazon-ssm-agent.service && ! systemctl is-active --quiet amazon-ssm-agent; then
  snap install amazon-ssm-agent --classic
fi
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service 2>/dev/null || systemctl enable --now amazon-ssm-agent

bash /opt/cosmotech/aws-serverless-lab/ops/itsm/bootstrap.sh
touch /var/lib/cosmotech-itsm-bootstrap-complete
